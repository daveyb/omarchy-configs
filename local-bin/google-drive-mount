#!/usr/bin/env bash
set -euo pipefail

"$(dirname "$0")/google-drive-pre" pre
exec /usr/bin/rclone mount gdrive: "${HOME}/GoogleDrive" \
	--config "${HOME}/.config/rclone/rclone.conf" \
	--cache-dir "${HOME}/.cache/rclone" \
	--vfs-cache-mode full \
	--vfs-cache-max-size 2G \
	--vfs-cache-max-age 168h \
	--dir-cache-time 15m \
	--poll-interval 1m \
	--log-level NOTICE \
	--log-file "${HOME}/.local/state/google-drive-mount/rclone.log"
