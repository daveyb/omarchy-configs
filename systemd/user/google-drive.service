[Unit]
Description=Google Drive folder, fetched on access
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=%h/.local/bin/google-drive-mount
ExecStop=%h/.local/bin/google-drive-pre stop
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10

[Install]
WantedBy=default.target
